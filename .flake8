[flake8]
max-line-length = 120
extend-ignore = E203, W503
per-file-ignores =
    **/test_*.py: F401, F841, E402, F541, F811, E722
    **/tests/*.py: F401, F841, F541, F811, E722
    **/__init__.py: F401
    analyzer/ml/tests/__init__.py: F403, F405, F401
    test_ml_integration.py: F401, F841, E402, F541, F811, E722
